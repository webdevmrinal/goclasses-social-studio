{
  "name": "goc-social-studio",
  "version": "1.0.0",
  "private": true,
  "description": "GO Classes Social Studio \u00e2\u20ac\u201d created by Mrinal",
  "author": "Mrinal",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node studio.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "setup": "playwright install chromium",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:accounts": "node tests/accounts-smoke.js",
    "test:editors": "node tests/editor-smoke.js",
    "test:instagram-publications": "node tests/instagram-publication-smoke.js",
    "test:instagram-ui": "node tests/instagram-ui.js",
    "test:x-submit": "node tests/x-submit-smoke.js",
    "test:manychat": "node tests/manychat-smoke.js",
    "test:whatsapp": "node tests/whatsapp-smoke.js",
    "test:destinations": "node tests/destinations-ui.js",
    "test:publications": "node tests/publication-smoke.js",
    "icons:build": "node scripts/build-icons.mjs",
    "check": "node --check server/index.js && node --check client/app.js && node --check studio.mjs && node --check scripts/studio-runner.mjs && node --check scripts/updates.mjs",
    "test:telegram": "node tests/telegram-smoke.js",
    "test:connections": "node tests/connections-ui.js",
    "android:status": "node scripts/android-worker.mjs status",
    "android:start": "node scripts/android-worker.mjs start",
    "android:cold-start": "node scripts/android-worker.mjs cold-start",
    "android:stop": "node scripts/android-worker.mjs stop",
    "android:doctor": "node scripts/android-worker.mjs doctor",
    "android:play-store": "node scripts/android-worker.mjs play-store",
    "test:polish-ui": "node tests/polish-ui.js",
    "test:updates": "node --test tests/updates.test.js && node tests/launcher-smoke.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-static": "^1.59.0",
    "multer": "^2.0.2",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "twitter-text": "^3.1.0"
  }
}
