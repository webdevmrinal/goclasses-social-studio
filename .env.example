# Node.js 22 or newer. Copy this file to .env.
PORT=3000
HOST=127.0.0.1
# Required for shared/tunnel access. Use at least 16 characters.
# APP_PASSWORD=replace-with-a-long-private-company-password
# Set to the exact public HTTPS address when using a tunnel.
# APP_ORIGIN=https://social.example.com
# COOKIE_SECURE=true
# Set to 1 only behind a single trusted reverse proxy / Cloudflare Tunnel.
# TRUST_PROXY=1
# To serve your local network instead, set HOST=0.0.0.0 and APP_PASSWORD.
# Separate browser profiles; never point this at your personal Chrome profile.
# DATA_DIR=./data
# Auto-detects installed Chrome, then Edge, then bundled Chromium.
# BROWSER_CHANNEL=chrome
# Optional absolute path for a non-standard Chrome or Edge installation.
# BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: pin the GitHub update branch. Defaults to the cloned branch.
# UPDATE_BRANCH=main

# Optional Gemini key for navigation suggestions (enable in Connections > Navigation help).
# GEMINI_API_KEY=your-key-here
